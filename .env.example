# Copy to .env and fill in. Empty values disable the feature.

# Public address of the site. It must be the root of a domain or subdomain.
DOMAIN=store.example.com
BASE_URL=https://store.example.com

# SteamID64 values allowed into /admin, comma separated.
ADMIN_STEAM_IDS=

# Optional: shows Steam names and avatars. Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Shared secret with the game plugin, 32+ characters. Generate with: openssl rand -hex 32
PLUGIN_SECRET=

# Stripe: buyers in the United States (and the default list).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal: default list for countries without their own rule.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live

# Mercado Pago: buyers in South America.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_USE_SANDBOX_URL=false

# Buyer location. Behind Cloudflare set GEOIP_HEADER=cf-ipcountry (most accurate).
# Otherwise the server downloads a public IP-to-country database once a day.
GEOIP_HEADER=
GEOIP_AUTO_UPDATE=true

# Reverse proxies whose X-Forwarded-For is trusted (Caddy in Docker is on a private network).
TRUST_PROXY=loopback,linklocal,uniquelocal
LOG_LEVEL=info
