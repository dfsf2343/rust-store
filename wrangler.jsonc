// Cloudflare Workers deployment (free plan). See README.md, section "Hosting gratis en Cloudflare".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rust-store",
  "main": "server/src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Served at https://rust-store.<your-subdomain>.workers.dev. No per-version preview URLs:
  // they would share the production database.
  "workers_dev": true,
  "preview_urls": false,
  // Installs dependencies, builds the website and writes web/dist/_headers before every deploy.
  "build": {
    "command": "npm run build:cloudflare",
    "watch_dir": ["web/src", "config"]
  },
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker so the members-only gate (ACCESS_PASSWORD) covers files too.
    "run_worker_first": true
  },
  // The database: one SQLite-backed Durable Object.
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "StoreObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StoreObject"] }],
  // Expires abandoned checkouts and prunes old rows.
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "NODE_ENV": "production",
    "LOG_LEVEL": "info"
  },
  // Keep variables added in the dashboard (ADMIN_STEAM_IDS, PAYPAL_ENV, ...) across deploys.
  "keep_vars": true,
  "observability": { "enabled": true }
}
